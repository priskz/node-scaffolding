{
	"name": "node-scaffolding",
	"version": "0.0.1",
	"description": "Generic application scaffolding built with TypeScript, Node, and Express",
	"author": "Zachary Prisk",
	"license": "UNLICENSED",
	"private": false,
	"main": "dist/server.js",
	"scripts": {
		"build": "rimraf ./dist/* && tsc && tsc-alias",
		"type-check": "tsc --noEmit",
		"lint": "eslint src/",
		"start": "NODE_ENV=production node ./dist/server.js",
		"dev": "tsx watch src/server.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cover": "vitest run --coverage",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:seed": "prisma db seed"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1023.0",
		"@aws-sdk/s3-request-presigner": "^3.1023.0",
		"@bull-board/api": "^6.20.6",
		"@bull-board/express": "^6.20.6",
		"@elastic/elasticsearch": "^7.8.0",
		"@prisma/adapter-pg": "^7.6.0",
		"@prisma/client": "^7.6.0",
		"@react-email/render": "^2.0.5",
		"axios": "^0.21.2",
		"bcrypt": "^5.0.0",
		"bullmq": "^5.72.1",
		"compression": "^1.7.4",
		"cookie-parser": "^1.4.5",
		"cors": "^2.8.6",
		"crypto-js": "^4.0.0",
		"deep-diff": "^1.0.2",
		"dotenv": "^8.2.0",
		"eventemitter2": "^6.4.9",
		"express": "^4.17.1",
		"express-async-handler": "^1.1.4",
		"express-rate-limit": "^8.3.2",
		"helmet": "^8.1.0",
		"ioredis": "^5.10.1",
		"jose": "^6.2.2",
		"luxon": "^1.24.1",
		"mime-types": "^3.0.2",
		"nodemailer": "^8.0.4",
		"otplib": "^13.4.0",
		"passport": "^0.7.0",
		"passport-github2": "^0.1.12",
		"passport-google-oauth20": "^2.0.0",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"prisma": "^7.6.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"socket.io": "^4.8.3",
		"swagger-ui-express": "^4.1.4",
		"uuid": "^8.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bcrypt": "^3.0.0",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/crypto-js": "^3.1.47",
		"@types/deep-diff": "^1.0.0",
		"@types/express": "^5.0.6",
		"@types/luxon": "^1.24.2",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^25.5.0",
		"@types/nodemailer": "^7.0.11",
		"@types/passport": "^1.0.17",
		"@types/passport-github2": "^1.2.9",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/swagger-ui-express": "^4.1.2",
		"@types/uuid": "^8.0.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"eslint": "^10.1.0",
		"node-mocks-http": "^1.8.1",
		"pino-pretty": "^13.1.3",
		"prettier": "^1.19.1",
		"rimraf": "^3.0.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/priskz/node-scaffolding"
	}
}
